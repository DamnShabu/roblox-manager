+// Symlink every entry of `from` into `to` as `target_prefix`/<name>, keeping
+// whatever is already there. Hidden entries (/nix/store/.links) are skipped.
+static void link_all(const char* from, const char* target_prefix, const char* to)
+{
+	DIR* dir = opendir(from);
+	if (!dir) {
+		return;
+	}
+	struct dirent* entry;
+	while ((entry = readdir(dir))) {
+		if (entry->d_name[0] == '.') {
+			continue;
+		}
+		const char* target = strprintf("%s/%s", target_prefix, entry->d_name);
+		const char* link = strprintf("%s/%s", to, entry->d_name);
+		if (symlink(target, link) < 0 && errno != EEXIST) {
+			fprintf(stderr, "symlink %s -> %s: %s\n", link, target, strerror(errno));
+		}
+		free((void*) target);
+		free((void*) link);
+	}
+	closedir(dir);
+}
