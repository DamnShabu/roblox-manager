     /// Without it the cursor reappears wherever it was when the lock was taken,
     /// which after a long camera drag is not where the person looking at the
     /// screen thinks it is.
+    /// mujo: keep the cursor inside the window.
+    ///
+    /// Compositors disagree about which surface a constraint has to be on to
+    /// take effect, and a client cannot ask. Measured against each, with this
+    /// client, fullscreen:
+    ///
+    ///   niri 26.04, mutter 50   the surface under the pointer: the canvas
+    ///   sway 1.12, KWin 6.7     the toplevel (KWin: only while its input
+    ///                           region covers the pointer -- see
+    ///                           `input_region` in cordial-shell)
+    ///   Hyprland 0.55           the keyboard-focused toplevel, and it moves
+    ///                           pointer focus there -- see
+    ///                           [`toplevel_constraint_takes_the_pointer`]
+    ///
+    /// The protocol allows one constraint per surface rather than per window,
+    /// so both are asked for, and each compositor activates the one its own
+    /// rule picks; either keeps the cursor on this window.
+    fn confine_pointer(&self) {
+        let mut slots = self.confined_pointer.lock().unwrap_or_else(|e| e.into_inner());
+        if !slots.is_empty() {
+            return;
+        }
