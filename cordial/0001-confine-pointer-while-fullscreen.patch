+                    &CONFINED_POINTER_INTERFACE,
+                    1,
+                    0,
+                    std::ptr::null_mut::<c_void>(),
+                    target,
+                    self.capture_pointer,
+                    std::ptr::null_mut::<c_void>(),
+                    POINTER_CONSTRAINT_LIFETIME_PERSISTENT,
+                )
+            };
+            if cp.is_null() {
