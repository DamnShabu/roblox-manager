+// ---------------------------------------------- zwp_confined_pointer_v1
+//
+// mujo: the cursor kept inside a fullscreen window, the way a fullscreen game
+// does on Windows -- without it the pointer runs off onto the next monitor
+// mid-game. Unlike the lock it stays visible and moves freely; it just cannot
+// leave. The compositor allows one constraint per surface, so the confinement
+// gives way whenever the lock is wanted and comes back after it. Signatures
+// are `wayland-scanner private-code`'s over the same XML as the lock's.
+
+static CONFINED_POINTER_METHODS: [WlMessage; 2] = [
+    WlMessage { name: c"destroy".as_ptr(), signature: c"".as_ptr(), types: NO_TYPES.0.as_ptr() },
+    WlMessage {
+        name: c"set_region".as_ptr(),
+        signature: c"?o".as_ptr(),
+        types: NO_TYPES.0.as_ptr(),
+    },
+];
+static CONFINED_POINTER_EVENTS: [WlMessage; 2] = [
+    WlMessage { name: c"confined".as_ptr(), signature: c"".as_ptr(), types: NO_TYPES.0.as_ptr() },
+    WlMessage { name: c"unconfined".as_ptr(), signature: c"".as_ptr(), types: NO_TYPES.0.as_ptr() },
+];
+static CONFINED_POINTER_INTERFACE: WlInterface = WlInterface {
+    name: c"zwp_confined_pointer_v1".as_ptr(),
+    version: 1,
+    method_count: 2,
+    methods: CONFINED_POINTER_METHODS.as_ptr(),
+    event_count: 2,
+    events: CONFINED_POINTER_EVENTS.as_ptr(),
+};
+
+const CONFINED_POINTER_DESTROY: u32 = 0;
+
+/// How many of this window's confinements the compositor has active.
+static CONFINED_ACTIVE: AtomicI32 = AtomicI32::new(0);
+/// When the last active confinement was dropped while one was still wanted.
+/// A persistent constraint is supposed to come back by itself, and on most
+/// compositors it does; KWin drops it across the fullscreen transition itself
+/// and re-checks only on focus or activation changes, which do not follow --
+/// the same "deactivated and not restored" `sync_pointer_lock` handles for the
+/// lock. See [`WaylandWindow::confinement_went_dead`].
+static CONFINE_LOST_AT: Mutex<Option<std::time::Instant>> = Mutex::new(None);
+
+unsafe extern "C" fn confined_pointer_confined(_data: *mut c_void, _cp: *mut c_void) {
+    CONFINED_ACTIVE.fetch_add(1, Ordering::AcqRel);
+    *CONFINE_LOST_AT.lock().unwrap_or_else(|e| e.into_inner()) = None;
+}
+
+unsafe extern "C" fn confined_pointer_unconfined(_data: *mut c_void, _cp: *mut c_void) {
+    if CONFINED_ACTIVE.fetch_sub(1, Ordering::AcqRel) <= 1 {
+        CONFINED_ACTIVE.store(0, Ordering::Release);
+        *CONFINE_LOST_AT.lock().unwrap_or_else(|e| e.into_inner()) =
+            Some(std::time::Instant::now());
+    }
+}
+
+static CONFINED_POINTER_LISTENER: LockedPointerListener = LockedPointerListener {
+    locked: confined_pointer_confined,
+    unlocked: confined_pointer_unconfined,
+};
+
+/// mujo: whether an active constraint on the toplevel moves pointer focus onto
+/// the toplevel itself. Hyprland's does, on every motion (`confineToRegion` in
+/// its InputManager), and never hands it back to the subsurface under the
+/// cursor -- and the engine only takes pointer events on its canvas, so the
+/// game would lose the mouse for as long as the window is fullscreen. Hyprland
+/// also only activates the constraint of the keyboard-focused surface, which
+/// the canvas never is, so there the cursor is simply not confined: the same
+/// as upstream Cordial, whose lock cannot engage there either.
+fn toplevel_constraint_takes_the_pointer() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| {
+        std::env::var_os("HYPRLAND_INSTANCE_SIGNATURE").is_some()
+            || std::env::var("XDG_CURRENT_DESKTOP")
+                .is_ok_and(|d| d.to_ascii_lowercase().contains("hyprland"))
+    })
+}
+
+/// `CORDIAL_NO_FULLSCREEN_CONFINE=1` -- let the cursor leave a fullscreen
+/// window, as upstream Cordial does.
+fn no_fullscreen_confine() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var_os("CORDIAL_NO_FULLSCREEN_CONFINE").is_some())
+}
+
+/// Whether the cursor should be confined: fullscreen, no Cordial dialog in
+/// front, and the lock not wanted -- the lock takes the pointer entirely, and
+/// the protocol allows only one of the two at a time. (Focus needs no rule: a
+/// persistent confinement is suspended by the compositor while unfocused.)
+/// Pure, so the table is testable without a compositor.
+fn confine_wanted(fullscreen: bool, ui_in_front: bool, lock_wanted: bool) -> bool {
+    fullscreen && !ui_in_front && !lock_wanted
+}
 
